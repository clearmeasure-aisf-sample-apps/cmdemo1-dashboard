<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dashboard.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- coverlet.collector: the Build's test run measures coverage with it (the collector "XPlat Code Coverage"), and
       scripts/Write-BuildFacts.ps1 reads the Cobertura file it writes. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dashboard\Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Dashboard.Cluster" />
    <Using Include="Dashboard.Health" />
    <Using Include="Dashboard.Runtime" />
    <Using Include="Dashboard.Work" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The samples the app ships with: tests read them, so the samples always match the contract. -->
  <ItemGroup>
    <None Include="..\Dashboard\wwwroot\topology.json" Link="topology.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dashboard\wwwroot\samples\workitems.json" Link="workitems.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\feed-workitems.json" Link="feed-workitems.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dashboard\wwwroot\runtime\*.json;..\Dashboard\wwwroot\runtime\*.svg" Link="runtime.sample\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The multi-region web app diagram the kit's sample used to ship. cmdemo1's shipped sample has no App
       Service; these files keep the Front Door and web app checks. -->
  <ItemGroup>
    <None Include="Fixtures\webapp\topology.json" Link="webapp.topology.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\webapp\runtime\*.json;Fixtures\webapp\runtime\*.svg" Link="webapp.sample\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The cluster view's two files, as their producers write them. The app ships no sample of them: the sample
       topology names no cluster, since a topology takes absolute addresses only. -->
  <ItemGroup>
    <None Include="Samples\*.json" Link="cluster.sample\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
