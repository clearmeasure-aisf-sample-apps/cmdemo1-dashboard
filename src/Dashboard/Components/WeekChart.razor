@* The merged and deployed-to-prod bars for one slice. The words of the chart are on the chart itself. *@
@{
    var width = Chart.Bars.Count * BarPitch;
}
<svg class="weeks" viewBox="0 0 @Pixel(width) @Pixel(WorkItemsText.ChartHeight)" width="@Pixel(width * DrawnWidthScale)" height="@Pixel(WorkItemsText.ChartHeight * DrawnHeightScale)" role="img" aria-label="@Chart.Title" focusable="false">
    <title>@Chart.Title</title>
    @for (var index = 0; index < Chart.Bars.Count; index++)
    {
        var bar = Chart.Bars[index];
        var x = index * BarPitch;
        var merged = WorkItemsText.BarHeight(bar.Merged, Chart.Scale);
        var deployed = WorkItemsText.BarHeight(bar.DeployedProd, Chart.Scale);
        <rect class="weeks__merged" x="@Pixel(x)" y="@Pixel(WorkItemsText.ChartHeight - merged)" width="@BarWidth" height="@Pixel(merged)">
            <title>@bar.Title</title>
        </rect>
        <rect class="weeks__deployed" x="@Pixel(x + DeployedOffset)" y="@Pixel(WorkItemsText.ChartHeight - deployed)" width="@BarWidth" height="@Pixel(deployed)">
            <title>@bar.Title</title>
        </rect>
    }
</svg>
<p class="weeks__legend">
    <span class="weeks__key weeks__key--merged" title="Work items merged that week">Merged</span>
    <span class="weeks__key weeks__key--deployed" title="Work items deployed to prod that week">Deployed to prod</span>
</p>

@code {
    [Parameter, EditorRequired]
    public WorkWeekChart Chart { get; set; } = default!;

    /// <summary>The pitch of one week's slot: the distance from the start of one bar pair to the start of the next.</summary>
    private const int BarPitch = 14;

    /// <summary>The width of each bar, merged and deployed alike.</summary>
    private const int BarWidth = 5;

    /// <summary>How far the deployed bar sits from the merged bar of the same week.</summary>
    private const int DeployedOffset = 6;

    /// <summary>How the drawn width scales against the viewBox width.</summary>
    private const int DrawnWidthScale = 3;

    /// <summary>How the drawn height scales against the viewBox height.</summary>
    private const double DrawnHeightScale = 1.4;

    private static string Pixel(double value) => value.ToString(WorkItemsText.PixelFormat, CultureInfo.InvariantCulture);
}
