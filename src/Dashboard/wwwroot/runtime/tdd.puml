@startuml
!pragma layout smetana
skinparam backgroundColor #111a23
skinparam defaultFontColor #f4f6f8

title cmdemo1 tdd: ui container app is the only SQL user

rectangle "Azure subscription" as sub {
  rectangle "cae-cmdemo1-tdd\nContainer Apps environment" as cae {
    rectangle "ca-cmdemo1-tdd-ui\ncontainer app: ui" as ca_ui
  }
  rectangle "rg-cmdemo1-nonprod" as rg_tier {
    rectangle "centralus\ndata, static sites" as region_data {
      database "sqldb-cmdemo1-tdd" as sqldb
      rectangle "swa-cmdemo1-tdd-dashboard" as swa_dashboard
    }
  }
}
actor "Browser" as browser
browser --> ca_ui : public address
ca_ui --> sqldb : reads and writes
browser --> swa_dashboard : loads the dashboard
@enduml
